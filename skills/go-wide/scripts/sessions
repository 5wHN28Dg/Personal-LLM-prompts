#!/bin/sh
# usage: sessions            print the agent PIDs of live go-wide sessions on this machine:
#                            capped agent scopes whose agent is still running, plus running
#                            watchers (one PID per line)
#        sessions --watched  print only the agent PIDs that have a running watcher
watched() {
  systemctl --user list-units --plain --no-legend 'go-wide-watch-*' 2>/dev/null |
    sed -n 's/^go-wide-watch-\([0-9]*\)\.service.*/\1/p'
  pgrep -af 'memwatch [0-9]+$' 2>/dev/null | sed -n 's/.*memwatch \([0-9]*\)$/\1/p'
}
if [ "$1" = --watched ]; then watched | sort -u; exit 0; fi
{ watched
  for d in $(find /sys/fs/cgroup/user.slice -maxdepth 5 -type d -name '*-capped-*.scope' 2>/dev/null); do
    p=${d##*-capped-}; p=${p%.scope}; kill -0 "$p" 2>/dev/null && echo "$p"
  done; } | sort -u
