#!/bin/sh
# usage: budget              print this machine's memory budget as KEY=VALUE lines (GiB)
#        budget --available  print only the memory available right now (GiB)
# Inside a container (a cgroup namespace with its own memory or CPU limit), those limits
# count, not the host's. FLOOR_PCT: share of total RAM always kept free (default 20).
#   CAP         ceiling for this session's own processes: total minus floor. Fixed, so a
#               session started while memory is busy isn't capped below what it already uses.
#   JOB_BUDGET  memory you may give new memjobs right now: available, minus what running
#               memjobs may still grow into, minus floor and a margin, shared among the live
#               go-wide sessions on this machine (SESSIONS). Each session's fair share counts
#               what its own running memjobs may still grow into, so a session whose jobs
#               already hold a lot gets less and the others get more; the shares together
#               never exceed what is free. With no memjobs running, it's an even split.
#               0 = start nothing.
#               A memjob may grow to its whole limit, except a long-running one (started
#               with memjob --long: a server that doesn't rebuild) that is older than 10
#               minutes: it is expected to grow to at most 1.5 times what it holds now
#               (anon plus shared memory), at least 512 MiB, never above its limit.
# GO_WIDE_CGROUP_ROOT and GO_WIDE_MEMINFO replace /sys/fs/cgroup and /proc/meminfo (tests).
FLOOR_PCT=${FLOOR_PCT:-20}
CG=${GO_WIDE_CGROUP_ROOT:-/sys/fs/cgroup}
read_kb() { awk -v k="$1:" '$1==k {print $2}' "${GO_WIDE_MEMINFO:-/proc/meminfo}"; }
total=$(read_kb MemTotal) avail=$(read_kb MemAvailable)
if [ -r "$CG/memory.max" ] && [ -r "$CG/memory.current" ] && [ "$(cat "$CG/memory.max")" != max ]; then
  # container (cgroup namespace root): page cache that can be dropped doesn't count as used
  inact=$(awk '$1=="inactive_file" {print $2}' "$CG/memory.stat" 2>/dev/null)
  lim=$(( $(cat "$CG/memory.max") / 1024 )); used=$(( ($(cat "$CG/memory.current") - ${inact:-0}) / 1024 ))
  [ "$lim" -lt "$total" ] && total=$lim
  [ $((lim - used)) -lt "$avail" ] && avail=$((lim - used))
fi
[ "$1" = --available ] && { awk -v a="$avail" 'BEGIN{printf "%.1f\n", a/1048576}'; exit 0; }
cores=$(nproc)
if [ -r "$CG/cpu.max" ]; then
  set -- $(cat "$CG/cpu.max")
  [ "$1" != max ] && { q=$(( ($1 + $2 - 1) / $2 )); [ "$q" -lt "$cores" ] && cores=$q; }
fi
S=$(cd "$(dirname "$0")" && pwd)
live=" $("$S/sessions" | tr '\n' ' ') "
sessions=$(echo $live | wc -w)
# count this session too if it isn't capped or watched yet (step 1 runs before capself)
me=$("$S/findagent" 2>/dev/null)
case "$live" in *" $me "*) ;; *) [ -n "$me" ] && sessions=$((sessions+1)) ;; esac
[ "$sessions" -ge 1 ] || sessions=1
# memory already promised to running memjobs but not used yet. The scope folder is created
# when the job starts, so its modification time is the job's start time.
now=$(date +%s)
promised=$(find "$CG/user.slice" -maxdepth 5 -type d -name 'memjob-*.scope' 2>/dev/null | while read -r d; do
  # anon = memory the job really holds; its page cache already counts as available
  m=$(cat "$d/memory.max" 2>/dev/null); [ -n "$m" ] && [ "$m" != max ] || continue
  u=$(awk '$1=="anon" {print $2}' "$d/memory.stat" 2>/dev/null)
  case ${d##*/} in
    memjob-*-long-*.scope) age=$((now - $(stat -c %Y "$d" 2>/dev/null || echo "$now")))
      # shared memory (tmpfs, shm, shared mmaps) can't be reclaimed either, so it counts as held
      sh=$(awk '$1=="shmem" {print $2}' "$d/memory.stat" 2>/dev/null) ;;
    *) age=0 sh=0 ;;   # builds and tests: may still grow to their whole limit
  esac
  o=${d##*/}; o=${o#memjob-}; case $o in *-*) o=${o%%-*} ;; *) o=none ;; esac   # owner
  echo "$m ${u:--1} $age ${sh:-0} $o"
  done | awk '{ m=$1; u=$2+0; grow=m
    if (u<0) u=0   # unreadable use: keep the whole limit reserved
    else if ($3 >= 600) { u+=$4; grow=1.5*u; if (grow<536870912) grow=536870912; if (grow>m) grow=m }
    if (grow>u) p[$5]+=grow-u } END { for (o in p) printf "%s:%d ", o, p[o]/1024 }')
awk -v t="$total" -v a="$avail" -v pct="$FLOOR_PCT" -v cores="$cores" -v n="$sessions" \
    -v promised="$promised" -v live="$live" -v me="$me" 'BEGIN {
  t/=1048576; a/=1048576; floor=t*pct/100
  cap=int(t-floor); if (cap<2) cap=2
  # promised per owner (GiB); owners are agent pids, "none" for jobs with no owner in the name
  k=split(promised, items, " "); pr=0
  for (i=1; i<=k; i++) { split(items[i], f, ":"); po[f[1]]=f[2]/1048576; pr+=f[2]/1048576 }
  free=a-pr-floor-2.5   # 2.5 = stay above the WARNING level
  # each live session is due an equal share of free plus what live sessions already hold in
  # reserve, minus its own reserve; if those shares add up to more than free, scale them down
  k=split(live, L, " "); seen=0; held=0
  for (i=1; i<=k; i++) { held+=po[L[i]]; if (L[i]==me) seen=1 }
  if (me!="" && !seen) { L[++k]=me; held+=po[me] }
  fair=(free+held)/n; sum=0
  for (i=1; i<=k; i++) { g[L[i]]=fair-po[L[i]]; if (g[L[i]]<0) g[L[i]]=0; sum+=g[L[i]] }
  if (me=="" || k==0) jb=free/n       # this session is unknown: even split, as before
  else { jb=g[me]; if (sum>free) jb=(free>0 ? jb*free/sum : 0) }
  jb=int(jb); if (jb<0) jb=0
  printf "TOTAL=%.1f\nAVAILABLE=%.1f\nFLOOR=%.1f\nCAP=%d\nJOB_BUDGET=%d\nSESSIONS=%d\n", t, a, floor, cap, jb, n
  printf "WARN_AVAIL=%.1f\nCRIT_AVAIL=%.1f\nRECOVER_AVAIL=%.1f\n", floor+2.5, floor+0.5, floor+4.5
  printf "WARN_SCOPE=%.1f\nCRIT_SCOPE=%.1f\nMAX_JOBS=%d\n", cap*0.83, cap*0.94, cores
}'
