#!/bin/sh
# usage: budget              print this machine's memory budget as KEY=VALUE lines (GiB)
#        budget --available  print only the memory available right now (GiB)
# Inside a container (a cgroup namespace with its own memory or CPU limit), those limits
# count, not the host's. FLOOR_PCT: share of total RAM always kept free (default 20).
#   CAP         ceiling for this session's own processes: total minus floor. Fixed, so a
#               session started while memory is busy isn't capped below what it already uses.
#   JOB_BUDGET  memory you may give new memjobs right now: available, minus what running
#               memjobs may still grow into, minus floor and a margin, split evenly across
#               the live go-wide sessions on this machine (SESSIONS). 0 = start nothing.
#               A memjob may grow to its whole limit, except a long-running one (started
#               with memjob --long: a server that doesn't rebuild) that is older than 10
#               minutes: it is expected to grow to at most 1.5 times what it holds now
#               (anon plus shared memory), at least 512 MiB, never above its limit.
#               Its age is the time the machine was awake since the job's newest process
#               started, so a suspend, a clock change or a server restarted inside the job as
#               a new process don't make it look older (one that re-execs itself in place
#               does keep its age). A server that keeps starting new processes (recycled
#               workers) stays young. Where the age can't be measured, the job is young.
#   FREE        memory free for new memjobs on the whole machine right now (before splitting):
#               what memjob admits against. CEILING: what FREE would be with no memjobs
#               running; memjob refuses a bigger limit at once.
# Claims in the ledger (memjob writes one before starting a job, see memjob) count in full
# until their cgroup has its limit, and wants (jobs waiting to start) count in JOB_BUDGET.
# GO_WIDE_CGROUP_ROOT and GO_WIDE_PROC replace /sys/fs/cgroup and /proc (tests);
# GO_WIDE_MEMINFO replaces /proc/meminfo; GO_WIDE_STATE the ledger's folder.
FLOOR_PCT=${FLOOR_PCT:-20}
CG=${GO_WIDE_CGROUP_ROOT:-/sys/fs/cgroup}
PROC=${GO_WIDE_PROC:-/proc}
read_kb() { awk -v k="$1:" '$1==k {print $2}' "${GO_WIDE_MEMINFO:-$PROC/meminfo}"; }
total=$(read_kb MemTotal) avail=$(read_kb MemAvailable)
if [ -r "$CG/memory.max" ] && [ -r "$CG/memory.current" ] && [ "$(cat "$CG/memory.max")" != max ]; then
  # container (cgroup namespace root): page cache that can be dropped doesn't count as used
  inact=$(awk '$1=="inactive_file" {print $2}' "$CG/memory.stat" 2>/dev/null)
  lim=$(( $(cat "$CG/memory.max") / 1024 )); used=$(( ($(cat "$CG/memory.current") - ${inact:-0}) / 1024 ))
  [ "$lim" -lt "$total" ] && total=$lim
  [ $((lim - used)) -lt "$avail" ] && avail=$((lim - used))
fi
[ "$1" = --available ] && { awk -v a="$avail" 'BEGIN{printf "%.1f\n", a/1048576}'; exit 0; }
cores=$(nproc)
if [ -r "$CG/cpu.max" ]; then
  set -- $(cat "$CG/cpu.max")
  [ "$1" != max ] && { q=$(( ($1 + $2 - 1) / $2 )); [ "$q" -lt "$cores" ] && cores=$q; }
fi
S=$(cd "$(dirname "$0")" && pwd)
live=" $("$S/sessions" | tr '\n' ' ') "
sessions=$(echo $live | wc -w)
# count this session too if it isn't capped or watched yet (step 1 runs before capself)
me=$("$S/findagent" 2>/dev/null)
case "$live" in *" $me "*) ;; *) [ -n "$me" ] && sessions=$((sessions+1)) ;; esac
[ "$sessions" -ge 1 ] || sessions=1
# A --long job's age in seconds (0 = young), the smaller of two clocks, neither the wall clock:
# - since its newest process started, on the boot clock (counts suspend): a server
#   restarted inside the job as a new process is young again;
# - since systemd started the job, on the monotonic clock (stops during suspend). The shell
#   can't read that clock, so python3 does; without it every job counts as young.
up=$(awk '{print int($1)}' "$PROC/uptime" 2>/dev/null)
hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
mono=$(python3 -c 'import time; print(int(time.monotonic()))' 2>/dev/null)
long_age() {
  # every process of the job, including any in sub-groups a process created inside the scope
  newest=$(for p in $(find "$1" -name cgroup.procs -exec cat {} + 2>/dev/null); do
    sed 's/.*) //' "$PROC/$p/stat" 2>/dev/null | awk '{print $20}'; done | sort -n | tail -1)
  start=$(systemctl --user show -p ActiveEnterTimestampMonotonic --value "${1##*/}" 2>/dev/null)
  for v in "$newest" "$up" "$mono" "$start"; do   # anything unknown: young
    case "$v" in ''|0|*[!0-9]*) echo 0; return ;; esac
  done
  a=$((up - newest / hz)) m=$((mono - start / 1000000))
  [ "$m" -lt "$a" ] && a=$m
  echo "$a"
}
# the ledger: "claim <pid> <start> <unit> <bytes>" and "want <pid> <start> <bytes> <since>";
# an entry is live while its pid runs with the same start time (field 22 of its stat)
STATE=${GO_WIDE_STATE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/go-wide}
pstart() { sed 's/.*) //' "$PROC/$1/stat" 2>/dev/null | awk '{print $20}'; }
claimed=0 wanted=0
if [ -r "$STATE/ledger" ]; then
  while read -r kind pid st x bytes; do
    [ "$kind" = claim ] || [ "$kind" = want ] || continue
    [ -n "$pid" ] && [ "$(pstart "$pid")" = "$st" ] || continue   # dead or reused pid
    if [ "$kind" = want ]; then wanted=$((wanted + x)); continue; fi
    # a job whose cgroup already has its limit is counted from the cgroup below
    d=$(find "$CG/user.slice" -maxdepth 5 -type d -name "$x" 2>/dev/null | head -1)
    m=$([ -n "$d" ] && cat "$d/memory.max" 2>/dev/null)
    case "$m" in ''|max|*[!0-9]*) claimed=$((claimed + bytes)) ;; esac
  done <"$STATE/ledger"
fi
# what running memjobs hold (anon) and may still grow into
jobs=$(find "$CG/user.slice" -maxdepth 5 -type d -name 'memjob-*.scope' 2>/dev/null | while read -r d; do
  # anon = memory the job really holds; its page cache already counts as available
  m=$(cat "$d/memory.max" 2>/dev/null); [ -n "$m" ] && [ "$m" != max ] || continue
  u=$(awk '$1=="anon" {print $2}' "$d/memory.stat" 2>/dev/null)
  case ${d##*/} in
    memjob-*-long-*.scope) age=$(long_age "$d")
      # shared memory (tmpfs, shm, shared mmaps) can't be reclaimed either, so it counts as held
      sh=$(awk '$1=="shmem" {print $2}' "$d/memory.stat" 2>/dev/null) ;;
    *) age=0 sh=0 ;;   # builds and tests: may still grow to their whole limit
  esac
  echo "$m ${u:--1} $age ${sh:-0}"
  done | awk '{ m=$1; u=$2+0; grow=m
    if (u<0) u=0   # unreadable use: keep the whole limit reserved
    else if ($3 >= 600) { u+=$4; grow=1.5*u; if (grow<536870912) grow=536870912; if (grow>m) grow=m }
    if (grow>u) s+=grow-u; h+=u } END { printf "%d %d", s/1024, h/1024 }')
awk -v t="$total" -v a="$avail" -v pct="$FLOOR_PCT" -v cores="$cores" -v n="$sessions" \
    -v jobs="${jobs:-0 0}" -v cl="$claimed" -v wa="$wanted" 'BEGIN {
  split(jobs, j, " "); pr=j[1]/1048576; held=j[2]/1048576; cl/=1073741824; wa/=1073741824
  t/=1048576; a/=1048576; floor=t*pct/100
  cap=int(t-floor); if (cap<2) cap=2
  free=a-pr-cl-floor-2.5   # 2.5 = stay above the WARNING level
  jb=int((free-wa)/n); if (jb<0) jb=0
  printf "TOTAL=%.1f\nAVAILABLE=%.1f\nFLOOR=%.1f\nCAP=%d\nJOB_BUDGET=%d\nSESSIONS=%d\n", t, a, floor, cap, jb, n
  printf "FREE=%.2f\nCEILING=%.2f\n", (free>0 ? free : 0), a+held-floor-2.5
  printf "WARN_AVAIL=%.1f\nCRIT_AVAIL=%.1f\nRECOVER_AVAIL=%.1f\n", floor+2.5, floor+0.5, floor+4.5
  printf "WARN_SCOPE=%.1f\nCRIT_SCOPE=%.1f\nMAX_JOBS=%d\n", cap*0.83, cap*0.94, cores
}'
