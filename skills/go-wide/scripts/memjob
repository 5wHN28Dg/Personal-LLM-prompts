#!/bin/sh
# usage: memjob [--long] <GiB> <command...>: run in its own capped, kill-first group.
# --long marks a long-running server that doesn't rebuild and whose memory use stays flat:
# after 10 minutes, budget stops reserving its whole limit. Never use it for builds or tests.
# The unit is named memjob-<agent pid>-[long-]<pid>-<start>, so this session's watcher stops
# only its own jobs (the agent pid comes from this process's agent-capped-<pid>.scope, which
# every process the agent starts inherits; findagent is the fallback).
#
# Admission: before starting, memjob claims its limit in a ledger shared by every go-wide
# session on the machine ($XDG_RUNTIME_DIR/go-wide/ledger), under one lock, against the
# machine's FREE memory from budget, so two sessions can never both take the same memory.
# The claim lasts as long as this process (systemd-run --scope keeps its pid). If the limit
# doesn't fit, memjob waits in line, up to MEMJOB_WAIT seconds (default 20). Jobs ahead in
# line have their memory held for them: jobs waiting 10 s or more, then jobs of sessions below
# their fair share, then the rest; a session's own jobs keep their order. Exit 75:
# refused (not free in time, or more than could ever be free); nothing was started.
S=$(cd "$(dirname "$0")" && pwd)
kind=; [ "$1" = --long ] && { kind=long-; shift; }
lim=$1; shift
case "$lim" in ''|*[!0-9.]*|.|*.*.*) echo "usage: memjob [--long] <GiB> <command...>" >&2; exit 2 ;; esac
cg=$(cut -d: -f3 /proc/self/cgroup)
case "$cg" in
  *-capped-*.scope) root=${cg##*-capped-}; root=${root%.scope}
    kill -0 "$root" 2>/dev/null || root= ;;   # the scope's agent has exited
esac
[ -n "$root" ] || root=$("$S/findagent" "$PPID" 2>/dev/null)
# liveness always uses the real /proc: a test hook must never make other sessions' entries
# look dead (they would be deleted)
pstart() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | awk '{print $20}'; }
# the boot clock never steps back, unlike the wall clock
clock() { awk '{print int($1)}' /proc/uptime; }
CG=${GO_WIDE_CGROUP_ROOT:-/sys/fs/cgroup}
# live <kind> <pid> <start> <ns> <time> <unit>: is a ledger entry live? Entries carry the pid
# namespace that wrote them (ns=) and when (t=, boot clock); a claim's are on its "meta" line,
# so readers from older versions, which parse claim lines by position, aren't affected. A pid
# only means something in its own namespace. Entries from another namespace (a sandbox or
# container sharing XDG_RUNTIME_DIR) are kept while their job's cgroup exists; otherwise a
# claim lasts 60 s and a want 120 s from its time (a want refreshes it while waiting). A time
# in the future means another clock (a container's): expired. No ns: written here.
myns=$(readlink /proc/self/ns/pid 2>/dev/null | tr -dc 0-9)
live() {
  case "$3" in ''|*[!0-9]*) return 1 ;; esac   # malformed
  if [ -z "$4" ] || [ "$4" = "$myns" ]; then [ "$(pstart "$2")" = "$3" ]; return; fi
  case "$6" in *[*?[]*) ;; memjob-*.scope)
    [ -n "$(find "$CG/user.slice" -maxdepth 5 -type d -name "$6" 2>/dev/null | head -1)" ] && return 0 ;; esac
  case "$5" in ''|*[!0-9]*) return 1 ;; esac
  [ "$1" = want ] && ttl=120 || ttl=60
  age=$(( $(awk '{print int($1)}' /proc/uptime) - $5 ))
  [ "$age" -ge 0 ] && [ "$age" -lt "$ttl" ]
}
# entry_live <ledger line, with a claim's meta appended>: unpack it and call live
entry_live() {
  set -f; set -- $1; set +f
  k=$1 p=$2 s=$3 ns='' tm='' u=''
  for f; do case "$f" in ns=*) ns=${f#ns=} ;; t=*) tm=${f#t=} ;; esac; done
  [ "$k" = claim ] && u=$4
  [ "$k" = want ] && [ -z "$tm" ] && tm=$5
  live "$k" "$p" "$s" "$ns" "$tm" "$u"
}
# merged <ledger>: the ledger with each claim's meta appended to it, meta lines dropped
merged() {
  awk 'NR==FNR { if ($1=="meta") m[$2" "$3]=$4" "$5; next }
    $1=="meta" { next }
    $1=="claim" && (($2" "$3) in m) { print $0, m[$2" "$3]; next } { print }' "$1" "$1"
}
me=$$ st=$(pstart $$) session=${root:-0}
unit=memjob-${root:-0}-$kind$me-$st.scope
bytes=$(awk -v g="$lim" 'BEGIN { printf "%.0f", g*1073741824 }')
STATE=${GO_WIDE_STATE:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/go-wide}
wait_max=${MEMJOB_WAIT:-20}; case "$wait_max" in ''|*[!0-9]*) wait_max=20 ;; esac

# admit <lock wait s>: under the lock, drop dead entries, then claim if the limit fits.
# Prints "<verdict> <free> <ceiling> <held>": ok, wait (a want is recorded), busy (the lock
# wasn't free in time: wait, never start), refuse, or nolock (ledger or budget unusable).
# It runs in a subshell that alone holds fd 9, so the job never inherits the lock. A failed
# write never replaces the ledger.
admit() (
  mkdir -p "$STATE" 2>/dev/null
  # a failing redirection on exec would end the subshell before "|| nolock" runs
  ( : >>"$STATE/ledger.lock" ) 2>/dev/null || { echo nolock; exit; }
  exec 9>>"$STATE/ledger.lock"
  flock -w "$1" 9 || { echo busy; exit; }
  [ -f "$STATE/ledger" ] || echo "version 1" >"$STATE/ledger" || { echo nolock; exit; }
  # keep the version line and live entries (pid running with the same start time)
  tmp=$STATE/ledger.$$
  merged "$STATE/ledger" >"$tmp.in" || { rm -f "$tmp.in"; echo nolock; exit; }
  while read -r line || [ -n "$line" ]; do
    case "$line" in
      claim\ *) entry_live "$line" || continue
        # write the claim back in its old shape, its tags on a meta line
        set -f; set -- $line; set +f; echo "$1 $2 $3 $4 $5"; p=$2 s=$3; shift 5
        [ $# -gt 0 ] && echo "meta $p $s $*"; continue ;;
      want\ *) entry_live "$line" || continue ;;
    esac
    echo "$line"
  done <"$tmp.in" >"$tmp" && rm -f "$tmp.in" && mv "$tmp" "$STATE/ledger" || { rm -f "$tmp" "$tmp.in"; echo nolock; exit; }
  FREE='' CEILING=''
  # one floor for every session: a caller's FLOOR_PCT may raise it, never lower it
  fp=${FLOOR_PCT:-20}; case "$fp" in ''|*[!0-9]*) fp=20 ;; esac; [ "$fp" -lt 20 ] && fp=20
  # parsed, never eval'd: the values come partly from the ledger
  out=$(FLOOR_PCT=$fp "$S/budget" 2>/dev/null)
  FREE=$(echo "$out" | sed -n 's/^FREE=//p') CEILING=$(echo "$out" | sed -n 's/^CEILING=//p')
  RESERVED=$(echo "$out" | sed -n 's/^RESERVED="\(.*\)"$/\1/p')
  case "$RESERVED" in *[!0-9:\ ]*) RESERVED='' ;; esac   # malformed: no fair sharing, still safe
  # budget failed: admit without control (as before the ledger existed), and say so
  case "$FREE" in ''|*[!0-9.]*) echo nolock; exit ;; esac
  case "$CEILING" in ''|*[!0-9.]*) echo nolock; exit ;; esac
  # Who goes first among waiting jobs, highest priority first:
  #  1. jobs that have waited 10 s or more, oldest first (no one waits forever);
  #  2. jobs that keep their session within its fair share: (FREE + memory reserved by the
  #     active sessions) / number of active sessions (those with jobs running or waiting);
  #  3. the rest, oldest first.
  # Jobs of one session keep their order (oldest first). Memory for every waiting job ahead
  # of this one is held back. A session alone gets everything that fits.
  now=$(clock)
  mine=$(awk -v me="$me" '$1=="want" && $2==me {print $5; exit}' "$STATE/ledger")
  held=$(awk -v me="$me" -v sess="$session" -v b="$bytes" -v st="$st" -v since="${mine:-$now}" \
      -v now="$now" -v free="$FREE" -v res="$RESERVED" '
    BEGIN { g=1073741824; k=split(res, r, " "); for (i=1; i<=k; i++) { split(r[i], f, ":"); R[f[1]]=f[2] }
            n=0 }
    function older(j, i) {   # j arrived before i: by arrival, then start time, then pid
      return T[j]<T[i] || (T[j]==T[i] && (S[j]<S[i] || (S[j]==S[i] && P[j]<P[i]))) }
    $1=="want" && $2!=me { w++; P[w]=$2; S[w]=$3; B[w]=$4; T[w]=$5; X[w]=($6=="" ? "p" $2 : $6) }
    END {
      w++; P[w]=me; S[w]=st; B[w]=b; T[w]=since; X[w]=sess   # this job, as if waiting
      for (o in R) if (R[o]>0) A[o]=1
      for (i=1; i<=w; i++) A[X[i]]=1
      tot=free*g; for (o in A) { n++; tot+=R[o] }
      fair=tot/n
      # a job is within the fair share of its session if the reserve of the session plus
      # this job and the older waiting jobs of the same session fit in it; a job never ranks
      # better than an older job of its own session, so the order stays consistent
      for (i=1; i<=w; i++) { cum=B[i]
        for (j=1; j<=w; j++) if (j!=i && X[j]==X[i] && older(j, i)) cum+=B[j]
        D[i]=(now-T[i]>=10 ? 0 : (R[X[i]]+cum<=fair ? 1 : 2)) }
      for (i=1; i<=w; i++) { C[i]=D[i]
        for (j=1; j<=w; j++) if (j!=i && X[j]==X[i] && older(j, i) && D[j]>C[i]) C[i]=D[j] }
      for (i=1; i<w; i++) {
        # within one session, oldest first; between sessions, by priority, then oldest. A
        # newer job ahead only by priority is held for only if it could start now: memory
        # never sits idle for a job that cannot use it yet (aging still protects it)
        if (X[i]==X[w]) { if (older(i, w)) h+=B[i] }
        else if (C[i]<C[w] || (C[i]==C[w] && older(i, w))) { if (older(i, w) || B[i]<=free*g) h+=B[i] }
      }
      printf "%.0f", h }' "$STATE/ledger")
  verdict=$(awk -v b="$bytes" -v f="$FREE" -v c="$CEILING" -v h="$held" 'BEGIN {
    g=1073741824; if (b > c*g) print "refuse"; else if (b <= f*g - h) print "ok"; else print "wait" }')
  { awk -v me="$me" '!($1=="want" && $2==me)' "$STATE/ledger"
    case "$verdict" in
      ok) echo "claim $me $st $unit $bytes"; echo "meta $me $st ns=$myns t=$now" ;;
      wait) echo "want $me $st $bytes ${mine:-$now} $session ns=$myns t=$now" ;;
    esac; } >"$tmp" && mv "$tmp" "$STATE/ledger" || { rm -f "$tmp"; echo nolock; exit; }
  echo "$verdict $FREE $CEILING $(awk -v h="$held" 'BEGIN { printf "%.2f", h/1073741824 }')"
)
withdraw() (   # remove this process's want (on giving up)
  ( : >>"$STATE/ledger.lock" ) 2>/dev/null || exit 0
  exec 9>>"$STATE/ledger.lock"; flock -w 10 9 || exit 0
  awk -v me="$me" '!($1=="want" && $2==me)' "$STATE/ledger" >"$STATE/ledger.$$" &&
    mv "$STATE/ledger.$$" "$STATE/ledger" || rm -f "$STATE/ledger.$$"
)

if command -v flock >/dev/null; then
  t0=$(clock) said=0
  while :; do
    left=$((wait_max - ($(clock) - t0))); lw=5; [ "$left" -lt 5 ] && lw=$((left > 1 ? left : 1))
    r=$(admit "$lw"); v=${r%% *}
    r=${r#* }; free=${r%% *}; r=${r#* }; ceil=${r%% *}; held=${r#* }
    case "$v" in
      ok) break ;;
      wait|busy) ;;
      refuse) withdraw
        echo "memjob: refused: $lim GiB is more than could ever be free here ($ceil GiB with no memjobs running); use a smaller limit" >&2
        exit 75 ;;
      *) v=nolock; break ;;   # nolock, or admit died: start as before the ledger existed
    esac
    now=$(clock)
    if [ $((now - t0)) -ge "$wait_max" ]; then
      withdraw
      if [ "$v" = busy ]; then why="the ledger stayed locked"
      else why="free now $free GiB, $held GiB of it held for jobs ahead of it"; fi
      echo "memjob: refused: $lim GiB not free after $wait_max s ($why); retry later, use a smaller limit, or raise MEMJOB_WAIT" >&2
      exit 75
    fi
    [ $((now - said)) -ge 10 ] && { echo "memjob: waiting for $lim GiB (free $free GiB)" >&2; said=$now; }
    sleep 2
  done
  [ "$v" = nolock ] && echo "memjob: ledger unavailable; starting without admission control" >&2
else
  echo "memjob: flock not found; starting without admission control" >&2
fi
exec systemd-run --user --scope -q --collect --unit="$unit" \
  -p MemoryMax="${lim}G" -p MemorySwapMax=0 choom -n 1000 -- "$@"
