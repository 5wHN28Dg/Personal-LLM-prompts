#!/bin/sh
# usage: memjob [--long] <GiB> <command...>: run in its own capped, kill-first group.
# --long marks a long-running process (dev server, emulator back end) whose use stays flat:
# after 10 minutes, budget stops reserving its whole limit. Never use it for builds or tests.
# The unit is named memjob-<agent pid>-<n> (memjob-<agent pid>-long-<n> with --long), so this
# session's watcher stops only its own jobs.
# The agent pid comes from this process's cgroup (agent-capped-<pid>.scope), which every
# process the agent starts inherits, even if it's orphaned; findagent is the fallback when
# there's no such scope or its agent has exited.
S=$(cd "$(dirname "$0")" && pwd)
kind=; [ "$1" = --long ] && { kind=long-; shift; }
lim=$1; shift
cg=$(cut -d: -f3 /proc/self/cgroup)
case "$cg" in
  *-capped-*.scope) root=${cg##*-capped-}; root=${root%.scope}
    kill -0 "$root" 2>/dev/null || root= ;;   # the scope's agent has exited
esac
[ -n "$root" ] || root=$("$S/findagent" "$PPID" 2>/dev/null)
exec systemd-run --user --scope -q --collect --unit="memjob-${root:-0}-$kind$$" \
  -p MemoryMax="${lim}G" -p MemorySwapMax=0 choom -n 1000 -- "$@"
