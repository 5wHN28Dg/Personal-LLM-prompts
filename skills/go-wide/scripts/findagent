#!/bin/sh
# usage: findagent [pid]: print the root PID of the coding agent that owns this process.
# Walks up the process tree and returns the highest of the consecutive ancestors whose
# program is a known agent (or an ACP bridge such as Zed's claude-agent-acp). Only the
# program is matched, never its arguments, so an editor or terminal opened on a folder
# named after an agent isn't mistaken for one. For interpreters (node, python, bun, deno)
# the program is the script path. Override: AGENT_ROOT_PID=<pid>. Extra names:
# AGENT_MATCH='name1|name2'.
[ -n "$AGENT_ROOT_PID" ] && { echo "$AGENT_ROOT_PID"; exit 0; }
names="claude|codex|gemini|opencode|goose|kimi|qwen|aider|cursor-agent|amp|crush|copilot|droid|cline|kilo|junie|auggie|vibe${AGENT_MATCH:+|$AGENT_MATCH}"
is_agent() {
  a0=$(tr '\0' '\n' </proc/$1/cmdline 2>/dev/null | sed -n 1p)
  case ${a0##*/} in
    node|nodejs|bun|deno|python|python3|python3.*)
      # the program is the first non-flag argument, or the module after -m
      prog=$(tr '\0' '\n' </proc/$1/cmdline 2>/dev/null | awk 'NR==1 {next}
        m {print; exit} $0=="-m" {m=1; next} /^-/ {next} {print; exit}') ;;
    *) prog=${a0##*/} ;;
  esac
  # match any path component of the program (catches .../claude-agent-acp/dist/index.js)
  echo "$prog" | tr '/' '\n' | grep -Eq "^($names)([-_.@].*)?$|-acp([-_.@].*)?$"
}
p=${1:-$PPID} root=
while [ "$p" -gt 1 ] 2>/dev/null; do
  if is_agent "$p"; then root=$p
  elif [ -n "$root" ]; then break; fi
  p=$(awk '{print $4}' /proc/$p/stat 2>/dev/null) || break
done
[ -n "$root" ] && echo "$root"
