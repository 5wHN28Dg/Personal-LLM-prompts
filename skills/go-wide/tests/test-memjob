#!/bin/sh
# usage: test-memjob: check memjob's admission through the shared ledger. Uses fake meminfo
# and cgroups for budget, a private ledger folder, and a stub systemd-run that runs nothing
# real: it records its arguments and keeps the memjob's pid alive for a while, as a job would.
here=$(cd "$(dirname "$0")" && pwd)
t=$(mktemp -d "${TMPDIR:-/tmp}/go-wide-test.XXXXXX") || exit 1
pids=
trap 'kill $pids 2>/dev/null; rm -rf "$t"' EXIT
mkdir -p "$t/bin" "$t/state" "$t/cg/user.slice"
for f in memjob budget; do cp "$here/../scripts/$f" "$t/bin/"; done
printf '#!/bin/sh\necho 101\n' >"$t/bin/sessions"
printf '#!/bin/sh\nexit 1\n' >"$t/bin/findagent"
# the job: note the unit and whether it holds the ledger lock, then live for $JOB_SECS seconds
cat >"$t/bin/systemd-run" <<'STUB'
#!/bin/sh
for a; do case "$a" in --unit=*) echo "${a#--unit=}" >>"$JOBLOG" ;; esac; done
[ -n "$NAME" ] && echo "start $NAME" >>"$JOBLOG"
while [ $# -gt 0 ] && [ "$1" != -- ]; do shift; done; [ $# -gt 0 ] && shift   # the command after "choom ... --"
for a; do echo "arg <$a>"; done >>"$JOBLOG"
if flock -n "$GO_WIDE_STATE/ledger.lock" true; then echo "lock free" >>"$JOBLOG"; else echo "lock held" >>"$JOBLOG"; fi
sleep "${JOB_SECS:-0}"
STUB
chmod +x "$t/bin/"*
# machine: 10 GiB total, 8 GiB available: floor 2, margin 2.5, so FREE = 3.5 GiB, CEILING 3.5
printf 'MemTotal: %d kB\nMemAvailable: %d kB\n' 10485760 8388608 >"$t/meminfo"
export PATH="$t/bin:$PATH" GO_WIDE_STATE=$t/state GO_WIDE_CGROUP_ROOT=$t/cg GO_WIDE_MEMINFO=$t/meminfo JOBLOG=$t/jobs
fail=0
check() { if [ "$2" = "$3" ]; then echo "ok   $1 ($3)"; else echo "FAIL $1: expected $2, got $3"; fail=1; fi; }
mj() { "$t/bin/memjob" "$@" true 2>"$t/err"; }
ledger() { grep -c "^$1 " "$t/state/ledger"; }
reset() { rm -f "$t/state/ledger" "$JOBLOG"; kill $pids 2>/dev/null; wait 2>/dev/null; pids=; }
# a live process with its real start time, to hold a claim or a want in the ledger
holder() { sleep 60 & p=$!; pids="$pids $p"
  echo "$1 $p $(sed 's/.*) //' /proc/$p/stat | awk '{print $20}') $2" >>"$t/state/ledger"; }

reset; mj 3; check "fits: started" 0 $?
check "fits: claim written" 1 "$(ledger claim)"
check "the job doesn't hold the lock" "lock free" "$(grep "^lock " "$JOBLOG")"
case "$(head -1 "$JOBLOG")" in memjob-*-[0-9]*-[0-9]*.scope) r=named ;; *) r="$(head -1 "$JOBLOG")" ;; esac
check "unit name has pid and start time" named "$r"

reset; mj 4; check "more than could ever be free: refused" 75 $?
check "...at once, nothing started" 0 "$(cat "$JOBLOG" 2>/dev/null | wc -l)"
grep -q 'more than could ever be free' "$t/err"; check "...with a message" 0 $?

# another job's live claim of 2 GiB leaves 1.5: a 3 GiB job waits, then gives up
reset; echo "version 1" >"$t/state/ledger"; holder claim "memjob-9-1-1.scope $((2*1073741824))"
MEMJOB_WAIT=3 mj 3; check "claimed memory isn't free: refused after waiting" 75 $?
grep -q 'not free after 3 s' "$t/err"; check "...with a message" 0 $?
check "...and its want withdrawn" 0 "$(ledger want)"
# a claim whose process has exited is dropped
reset; echo "version 1" >"$t/state/ledger"; holder claim "memjob-9-1-1.scope $((2*1073741824))"
kill $pids; wait 2>/dev/null
mj 3; check "dead claim dropped: started" 0 $?
check "...and removed from the ledger" 1 "$(ledger claim)"
# a claim with the right pid but another start time (pid reused) is dropped too
reset; sleep 60 & p=$!; pids=$p; printf 'version 1\nclaim %s 1 memjob-9-1-1.scope %s\n' $p $((2*1073741824)) >"$t/state/ledger"
mj 3; check "reused pid's claim dropped" 0 $?

# the oldest waiting job has its memory held: with a 2 GiB want waiting, 2 GiB jobs wait,
# 1.5 GiB ones pass (3.5 - 2 = 1.5)
reset; echo "version 1" >"$t/state/ledger"; holder want "$((2*1073741824)) 1"
MEMJOB_WAIT=1 mj 2; check "head of line holds its memory: later job waits" 75 $?
mj 1.5; check "...a job that fits beside it starts" 0 $?

# two memjobs at once with room for one: exactly one starts, the other is refused
reset; ( export MEMJOB_WAIT=1 JOB_SECS=4; mj 2 & mj 2 & wait ) 2>/dev/null
check "two at once, room for one: one started, the other refused" 1 "$(grep -c '^memjob-' "$JOBLOG")"
# while the job runs its claim counts, so budget shows less FREE
reset; JOB_SECS=3 "$t/bin/memjob" 3 true 2>/dev/null & pids=$!; sleep 1
check "budget counts a running job's claim" 0.50 "$("$t/bin/budget" | sed -n 's/^FREE=//p')"
wait
# a claimed job whose cgroup exists but has no limit yet still counts in full
reset; mkdir -p "$t/cg/user.slice/app.slice/memjob-9-1-1.scope"; echo max >"$t/cg/user.slice/app.slice/memjob-9-1-1.scope/memory.max"
echo "version 1" >"$t/state/ledger"; holder claim "memjob-9-1-1.scope $((2*1073741824))"
check "claim counts until its cgroup has a limit" 1.50 "$("$t/bin/budget" | sed -n 's/^FREE=//p')"
rm -r "$t/cg/user.slice/app.slice"

# a claimed job whose cgroup has its limit is counted once, from the cgroup (2 GiB reserved)
reset; mkdir -p "$t/cg/user.slice/app.slice/memjob-9-1-1.scope"; d=$t/cg/user.slice/app.slice/memjob-9-1-1.scope
echo $((2*1073741824)) >"$d/memory.max"; echo "anon 0" >"$d/memory.stat"
echo "version 1" >"$t/state/ledger"; holder claim "memjob-9-1-1.scope $((2*1073741824))"
check "claim not counted twice once its cgroup has a limit" 1.50 "$("$t/bin/budget" | sed -n 's/^FREE=//p')"
rm -r "$t/cg/user.slice/app.slice"

# low memory (3 of 10 GiB available, below floor + margin): refused, never started unchecked
reset; printf 'MemTotal: %d kB\nMemAvailable: %d kB\n' 10485760 3145728 >"$t/meminfo"
mj 1; check "low memory: refused" 75 $?
grep -q 'without admission control' "$t/err"; check "...not started without control" 1 $?
printf 'MemTotal: %d kB\nMemAvailable: %d kB\n' 10485760 8388608 >"$t/meminfo"

# first come, first served between real waiters: a 2.5 GiB claim leaves 1 GiB for 5 s;
# A (3 GiB) starts waiting, then B (1 GiB, which would fit now). B must not jump ahead,
# and A must not be held back by B: A starts once the claim ends, then B after A's job.
reset; echo "version 1" >"$t/state/ledger"; sleep 5 & p=$!; pids=$p
echo "claim $p $(sed 's/.*) //' /proc/$p/stat | awk '{print $20}') memjob-9-1-1.scope $((5*1073741824/2))" >>"$t/state/ledger"
( export MEMJOB_WAIT=20 JOB_SECS=2; NAME=A mj 3 & sleep 1; NAME=B mj 1 & wait ) 2>/dev/null
check "first come, first served" "start A start B" "$(grep '^start' "$JOBLOG" | tr '\n' ' ' | sed 's/ $//')"

# an unusable ledger folder: started with a warning, not refused
reset; mkdir -p "$t/ro"; chmod 500 "$t/ro"
GO_WIDE_STATE=$t/ro/state mj 1; check "unwritable ledger folder: started" 0 $?
grep -q 'without admission control' "$t/err"; check "...with a warning" 0 $?
chmod 700 "$t/ro"
# a bad MEMJOB_WAIT falls back to the default instead of waiting forever
reset; echo "version 1" >"$t/state/ledger"; holder claim "memjob-9-1-1.scope $((3*1073741824))"
MEMJOB_WAIT=abc mj 3; check "bad MEMJOB_WAIT: default wait, then refused" 75 $?

# the command and its arguments reach the job unchanged
reset; "$t/bin/memjob" 1 printf '%s' 'a b' "c" 2>/dev/null
check "command arguments kept" "arg <printf> arg <%s> arg <a b> arg <c>" "$(grep '^arg' "$JOBLOG" | tr '\n' ' ' | sed 's/ $//')"

# a busy lock is waited for, never a reason to start unchecked: held 8 s, MEMJOB_WAIT=3
reset; flock "$t/state/ledger.lock" sleep 8 & pids=$!; sleep 0.5
MEMJOB_WAIT=3 mj 1; check "lock held too long: refused, not started" 75 $?
grep -q 'stayed locked' "$t/err"; check "...saying why" 0 $?
# ...and if it's freed in time, the job starts
reset; flock "$t/state/ledger.lock" sleep 2 & pids=$!; sleep 0.5
MEMJOB_WAIT=10 mj 1; check "lock freed in time: started" 0 $?

# FLOOR_PCT can't loosen admission: with floor 0 FREE would be 5.5 GiB, but 4 GiB is refused
reset; FLOOR_PCT=0 MEMJOB_WAIT=1 mj 4; check "FLOOR_PCT below 20 doesn't loosen admission" 75 $?

# the wait uses the boot clock: a wall clock stepped back an hour doesn't stretch it
reset; echo "version 1" >"$t/state/ledger"; holder claim "memjob-9-1-1.scope $((3*1073741824))"
printf '#!/bin/sh\necho $(( $(/bin/date +%%s) - 3600 ))\n' >"$t/bin/date"; chmod +x "$t/bin/date"
s0=$(awk '{print int($1)}' /proc/uptime); MEMJOB_WAIT=3 mj 3; r=$?
s1=$(awk '{print int($1)}' /proc/uptime); rm "$t/bin/date"
check "clock stepped back: wait still ends" "75 short" "$r $([ $((s1 - s0)) -le 12 ] && echo short || echo long)"
grep -q 'held for jobs waiting longer' "$t/err"; check "refusal says how much is held for others" 0 $?

# hand-edited ledger: a last line without a newline is kept, a malformed claim is dropped
reset; sleep 60 & p=$!; pids=$p; st=$(sed 's/.*) //' /proc/$p/stat | awk '{print $20}')
printf 'version 1\nclaim 4000000\n\njunk\nclaim %s %s memjob-9-1-1.scope %s' $p $st $((3*1073741824)) >"$t/state/ledger"
MEMJOB_WAIT=1 mj 1; check "claim on an unterminated last line still counts" 75 $?
grep -q '^claim 4000000' "$t/state/ledger"; check "malformed claim dropped" 1 $?

# fair sharing between sessions. This test's own session is the one memjob will use.
cg=$(cut -d: -f3 /proc/self/cgroup); ME=0
case "$cg" in *-capped-*.scope) ME=${cg##*-capped-}; ME=${ME%.scope}; kill -0 "$ME" 2>/dev/null || ME=0 ;; esac
G=1073741824; now() { awk '{print int($1)}' /proc/uptime; }
# session 777 holds 2 GiB (FREE 1.5) and waits for 1 GiB more; this session holds nothing.
# Fair share: (1.5 + 2) / 2 = 1.75. 777 would go to 3 (over), this session to 1 (under):
# this job goes first, though 777's want is older
reset; echo "version 1" >"$t/state/ledger"; holder claim "memjob-777-1-1.scope $((2*G))"
holder want "$G $(( $(now) - 2 )) 777"
MEMJOB_WAIT=1 mj 1; check "under-share session goes before an over-share one's older want" 0 $?
# the other way round: this session holds the 2 GiB and 777 waits for 1: 777 goes first
reset; echo "version 1" >"$t/state/ledger"; holder claim "memjob-$ME-1-1.scope $((2*G))"
holder want "$G $(now) 777"
MEMJOB_WAIT=1 mj 1; check "over-share session waits for an under-share one" 75 $?
# once a want has waited 10 s it goes first, whatever the shares
reset; echo "version 1" >"$t/state/ledger"; holder claim "memjob-777-1-1.scope $((2*G))"
holder want "$G $(( $(now) - 15 )) 777"
MEMJOB_WAIT=1 mj 1; check "a want waiting 10 s goes first, whatever the shares" 75 $?
# budget reports each session's reserve
reset; echo "version 1" >"$t/state/ledger"; holder claim "memjob-777-1-1.scope $((2*G))"
check "budget's RESERVED per session" "\"777:$((2*G))\"" "$("$t/bin/budget" | sed -n 's/^RESERVED=//p')"

# if budget fails, the job starts without admission control, with a warning
reset; mv "$t/bin/budget" "$t/bin/budget.real"; printf '#!/bin/sh\nexit 1\n' >"$t/bin/budget"; chmod +x "$t/bin/budget"
mj 3; check "budget failing: started anyway" 0 $?
grep -q 'without admission control' "$t/err"; check "...with a warning" 0 $?
mv "$t/bin/budget.real" "$t/bin/budget"

reset; mj x; check "bad limit: usage error" 2 $?
exit $fail
