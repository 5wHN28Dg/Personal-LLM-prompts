#!/bin/sh
# usage: test-budget: check budget's JOB_BUDGET arithmetic against fake cgroups and meminfo.
# Runs a copy of budget next to stub sessions/findagent scripts, so no real cgroup is read.
here=$(cd "$(dirname "$0")" && pwd)
t=$(mktemp -d "${TMPDIR:-/tmp}/go-wide-test.XXXXXX") || exit 1
trap 'rm -rf "$t"' EXIT
mkdir "$t/bin"
cp "$here/../scripts/budget" "$t/bin/budget"
printf '#!/bin/sh\nprintf "%%s\\n" $STUB_SESSIONS\n' >"$t/bin/sessions"
printf '#!/bin/sh\nexit 1\n' >"$t/bin/findagent"
chmod +x "$t/bin/"*
fail=0 GiB=1073741824 MiB=1048576

# machine like the one in the report: 37.5 GiB total, 23.2 GiB available
setup() {
  rm -rf "$t/cg"; mkdir -p "$t/cg/user.slice/app.slice"
  printf 'MemTotal: %d kB\nMemAvailable: %d kB\n' 39321600 24326963 >"$t/meminfo"
}
# job <name> <limit bytes> <anon bytes> <age seconds>
job() {
  d=$t/cg/user.slice/app.slice/$1.scope; mkdir -p "$d"
  echo "$2" >"$d/memory.max"; printf 'anon %d\nfile 0\n' "$3" >"$d/memory.stat"
  touch -d "@$(( $(date +%s) - $4 ))" "$d"
}
jb1() {  # uses $STUB_SESSIONS as set by the caller
  GO_WIDE_CGROUP_ROOT=$t/cg GO_WIDE_MEMINFO=$t/meminfo "$t/bin/budget" | sed -n 's/^JOB_BUDGET=//p'
}
jb() { STUB_SESSIONS="101 102"; export STUB_SESSIONS; jb1; }
check() {  # check <description> <expected> <actual>
  if [ "$2" = "$3" ]; then echo "ok   $1 (JOB_BUDGET=$3)"
  else echo "FAIL $1: expected JOB_BUDGET=$2, got $3"; fail=1; fi
}

# (23.2 - 7.5 - 2.5) / 2 = 6.6
setup; check "no memjobs" 6 "$(jb)"

# three 4 GiB idle --long servers (3 MiB each) running an hour: each reserves 512 MiB - 3 MiB
# (23.2 - 1.5 - 7.5 - 2.5) / 2 = 5.8
setup; for n in 1 2 3; do job memjob-9-long-$n $((4*GiB)) $((3*MiB)) 3600; done
check "idle long-running --long memjobs" 5 "$(jb)"

# the same servers started a minute ago keep their whole limit: (23.2 - 12 - 7.5 - 2.5) / 2 = 0.6
setup; for n in 1 2 3; do job memjob-9-long-$n $((4*GiB)) $((3*MiB)) 60; done
check "young --long memjobs keep full reservation" 0 "$(jb)"

# builds an hour into their run, quiet now, may still link up to their limits: no decay
# without --long, so (23.2 - 12 - 10) / 2 = 0.6 (the idle-server case from before, unflagged)
setup; for n in 1 2 3; do job memjob-9-$n $((4*GiB)) $((3*MiB)) 3600; done
check "old memjobs without --long keep full reservation" 0 "$(jb)"

# a --long job near its limit is reserved as before: 1.5 x 3.5 GiB caps at 4 GiB,
# so 0.5 GiB is promised: (23.2 - 0.5 - 7.5 - 2.5) / 2 = 6.35
setup; job memjob-9-long-1 $((4*GiB)) $((3584*MiB)) 3600
check "--long memjob near its limit" 6 "$(jb)"

# a --long job using 4 GiB of 8 GiB grows to 1.5 x 4 = 6, so 2 GiB is promised
# (not 4, nor a flat 0.5): (23.2 - 2 - 7.5 - 2.5) / 2 = 5.6
setup; job memjob-9-long-1 $((8*GiB)) $((4*GiB)) 3600
check "--long memjob grows to 1.5 x anon" 5 "$(jb)"
# with one session the same job gives 11.2: 11
setup; job memjob-9-long-1 $((8*GiB)) $((4*GiB)) 3600
check "one session, --long memjob" 11 "$(STUB_SESSIONS=101; export STUB_SESSIONS; jb1)"
# ...and the same job when young promises all 4 GiB: (23.2 - 4 - 7.5 - 2.5) / 2 = 4.6
setup; job memjob-9-long-1 $((8*GiB)) $((4*GiB)) 60
check "young --long memjob promises its whole headroom" 4 "$(jb)"

# the 10-minute boundary: 9 minutes is young, 11 minutes is old
setup; job memjob-9-long-1 $((8*GiB)) $((4*GiB)) 540
check "--long memjob at 9 minutes is young" 4 "$(jb)"
setup; job memjob-9-long-1 $((8*GiB)) $((4*GiB)) 660
check "--long memjob at 11 minutes is old" 5 "$(jb)"

# a memjob without a limit is skipped
setup; job memjob-9-long-1 max $((4*GiB)) 3600
check "memjob with no limit" 6 "$(jb)"

# an old --long job whose memory use can't be read keeps its whole limit: (23.2 - 8 - 10) / 2 = 2.6
setup; job memjob-9-long-1 $((8*GiB)) 0 3600; : >"$t/cg/user.slice/app.slice/memjob-9-long-1.scope/memory.stat"
check "old --long memjob with unreadable use" 2 "$(jb)"

# memjob --long names the unit memjob-<owner>-long-<n>, which budget recognizes and from which
# memwatch's owner parsing (memjob-<owner>-...) still gets the owner; without --long, no "long".
# systemd-run is stubbed to print its arguments, so nothing is started.
cp "$here/../scripts/memjob" "$t/bin/memjob"
printf '#!/bin/sh\nprintf "%%s\\n" "$@"\n' >"$t/bin/systemd-run"; chmod +x "$t/bin/systemd-run"
unit() { PATH=$t/bin:$PATH "$t/bin/memjob" "$@" | sed -n 's/^--unit=//p'; }
# the owner is this shell's agent (from its cgroup, or 0 when there is none), so any number
u=$(unit --long 0.5 true); o=${u#memjob-}; o=${o%%-*}
case "$u" in memjob-*-long-[0-9]*) echo "ok   memjob --long unit name ($u)" ;;
  *) echo "FAIL memjob --long unit name: got '$u'"; fail=1 ;; esac
case "$o" in ''|*[!0-9]*) echo "FAIL owner from --long unit name: got '$o'"; fail=1 ;;
  *) echo "ok   owner from --long unit name ($o)" ;; esac
u=$(unit 2 true)
case "$u" in *long*) echo "FAIL memjob unit name: got '$u'"; fail=1 ;;
  memjob-[0-9]*-[0-9]*) echo "ok   memjob unit name ($u)" ;;
  *) echo "FAIL memjob unit name: got '$u'"; fail=1 ;; esac
lim=$(PATH=$t/bin:$PATH "$t/bin/memjob" --long 0.5 true | grep -c '^MemoryMax=0.5G$')
[ "$lim" = 1 ] && echo "ok   memjob --long passes the limit" || { echo "FAIL memjob --long limit"; fail=1; }

exit $fail
